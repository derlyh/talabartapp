# ============================================================
# TALABARTAPP - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y completa los valores de tu proyecto
# ============================================================

# 1. Configuración de Supabase (Obtenida en Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY_PUBLICA

# Clave de servicio para Edge Functions o scripts de administración (Opcional - Uso privado)
# SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# 2. Configuración General de la Aplicación
APP_NAME=Talabartería El Rodeo
APP_CURRENCY=COP
APP_LOCALE=es-CO
PORT=8000
